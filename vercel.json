{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    {
      "source": "/app/:page(login|signup|onboarding|dashboard|tasks|calendar|timetable|notes|cgpa|attendance|achievements|notifications|settings).html",
      "destination": "/:page",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
