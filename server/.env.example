# Copy this file to server/.env (git-ignored) to run the API on this computer.
# See database/README.md, part 5.

# Option B — your local MySQL. These values match database/local-user.sql:
# a local-only development login that works from this computer alone.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=synora_app
DB_PASSWORD=Synora_Local_2026
DB_NAME=synora

# Option A — the cloud database (Aiven): replace the five values above with
# Aiven's Host / Port / avnadmin / Password / synora, and add its CA
# certificate on one line, writing each line break as \n:
# DB_SSL_CA=-----BEGIN CERTIFICATE-----\nMIIE...\n-----END CERTIFICATE-----

# Port the local API listens on. vite.config.js reads it and forwards /api to it.
API_PORT=4000

# Optional — password-reset emails through Brevo (database/README.md, part 6).
# MAIL_FROM must be a sender you verified in Brevo. APP_URL is where the
# emailed link points (defaults to the address the request came to).
# BREVO_API_KEY=xkeysib-...
# MAIL_FROM=you@example.com
# APP_URL=http://localhost:5173

# Optional — push reminders with Synora closed (database/README.md, part 7).
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# CRON_SECRET=

# Optional — timetable from a photo (part 8).
# ANTHROPIC_API_KEY=
